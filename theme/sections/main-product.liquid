<link rel="stylesheet" href="{{ 'pdp.css' | asset_url }}" type="text/css" media="all">
<script src="{{ 'pdp-page.js' | asset_url }}" defer></script>

<div class="product-page main-product-wrapper">
  <div class="product-left">
    <!-- Swiper Slider for Product Images -->
    <div class="swiper mySwiper">
      <div class="swiper-wrapper">
        {% for media in product.media %}
          <div class="swiper-slide">
            {{ media | image_url: width: 600 | image_tag }}
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </div>

  <div class="product-right">
    <h1 class="product-title">{{ product.title }}</h1>
    <div id="variant-info">
      <p class="product-price">
        <span id="variant-price">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span id="variant-compare-price" class="compare-price">
            {{ product.compare_at_price | money }}
          </span>
        {% endif %}
      </p>

      <!-- Custom Variant Selector development -->
      {% assign current_handle = product.handle %}
      {% assign variant_group_json = product.metafields.custom.variant_group.value %}
      {% if variant_group_json != blank %}
      {% assign variant_group = variant_group_json | parse_json %}

      {% assign all_variants = variant_group | map: "variant_name" | uniq %}
      {% assign all_weights = variant_group | map: "weight" | uniq %}
      {% assign all_packaging = variant_group | map: "packaging" | uniq %}

      {% assign current_variant = null %}
      {% for item in variant_group %}
        {% if item.product_handle == current_handle %}
          {% assign current_variant = item %}
        {% endif %}
      {% endfor %}

      {% if current_variant %}
        <div class="custom-variant-section">
          <!-- Variant Selector (switch flavor type) -->
          <div class="selector-block">
            <p class="title-label-text"><strong>Variant:</strong></p>
            <div class="button-group">
              {% for v in all_variants %}
                {% assign match = variant_group | where: "variant_name", v | where: "weight", current_variant.weight | where: "packaging", current_variant.packaging %}
                {% assign target = match[0] %}
                {% if target %}
                  <button data-url="/products/{{ target.product_handle }}" class="link-text{% if target.product_handle == current_handle %} active{% endif %}">
                    {{ v }}
                  </button>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <!-- Weight Selector (within same variant_name group) -->
          <div class="selector-block">
            <p class="title-label-text"><strong>Weight:</strong></p>
            <div class="button-group">
              {% for w in all_weights %}
                {% assign match = variant_group | where: "variant_name", current_variant.variant_name | where: "weight", w %}
                {% assign matched_by_weight = null %}
                {% for m in match %}
                  {% if m.packaging == current_variant.packaging %}
                    {% assign matched_by_weight = m %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                {% if matched_by_weight == null %}
                  {% assign matched_by_weight = match[0] %}
                {% endif %}
                {% if matched_by_weight %}
                  <button data-url="/products/{{ matched_by_weight.product_handle }}" class="link-text{% if matched_by_weight.product_handle == current_handle %} active{% endif %}">
                    {{ w }}
                  </button>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <!-- Packaging Selector (within same variant_name group) -->
          <div class="selector-block">
            <p class="title-label-text"><strong>Packaging:</strong></p>
            <div class="button-group">
              {% for p in all_packaging %}
                {% assign match = variant_group | where: "variant_name", current_variant.variant_name | where: "packaging", p %}
                {% assign matched_by_packaging = null %}
                {% for m in match %}
                  {% if m.weight == current_variant.weight %}
                    {% assign matched_by_packaging = m %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                {% if matched_by_packaging == null %}
                  {% assign matched_by_packaging = match[0] %}
                {% endif %}
                {% if matched_by_packaging %}
                  <button data-url="/products/{{ matched_by_packaging.product_handle }}" class="link-text {% if matched_by_packaging.product_handle == current_handle %} active{% endif %}">
                    {{ p }}
                  </button>
                {% endif %}
              {% endfor %}
            </div>
          </div>

        </div>
      {% else %}
        <p><strong>Error:</strong> Could not find current variant in metafield.</p>
      {% endif %}
      {% else %}
      <p><strong>Error:</strong> Metafield is empty or missing.</p>
      {% endif %}

      <form method="post" action="{{ routes.cart_add_url }}" id="add-to-cart-form">
        <span class="quantity-label-text" for="quantity">Quantity:</span>
        {% assign max_qty = product.variants.first.inventory_quantity %}
        <div class="quantity-selector">
          <button type="button" id="qty-minus" class="qty-btn" {% if max_qty == 0 or product.variants.first.available == false %}disabled{% endif %}>
            <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-minus" fill="none" viewBox="0 0 256 256">
              <path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128Z" fill="currentColor"></path>
            </svg>
          </button>
          <input max="{{ max_qty }}" type="text" id="quantity" name="quantity" value="1" readonly {% if max_qty == 0 or product.variants.first.available == false %}disabled{% endif %} />
          <button type="button" id="qty-plus" class="qty-btn" {% if max_qty == 0 or product.variants.first.available == false %}disabled{% endif %}>
            <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-plus" fill="none" viewBox="0 0 256 256">
              <path d="M224,128a8,8,0,0,1-8,8H136v80a8,8,0,0,1-16,0V136H40a8,8,0,0,1,0-16h80V40a8,8,0,0,1,16,0v80h80A8,8,0,0,1,224,128Z" fill="currentColor"></path>
            </svg>
          </button>
        </div>
        <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
        <button type="submit" class="add-to-cart-btn-wrapper" id="add-to-cart-btn" {% if max_qty == 0 or product.variants.first.available == false %}disabled{% endif %}>
          <span>ADD TO CART</span>
          <div class="loading__spinner">
            <svg aria-hidden="true" focusable="false" class="spinner icon icon--extra-medium" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
              <circle class="path" fill="none" stroke-width="4" cx="33" cy="33" r="30"></circle>
            </svg>
          </div>
        </button>
        {% if max_qty == 0 or product.variants.first.available == false %}
          <p class="out-of-stock-message" style="color:red; font-weight:bold;">Out of stock</p>
        {% endif %}
      </form>
    </div>
  </div>
</div>